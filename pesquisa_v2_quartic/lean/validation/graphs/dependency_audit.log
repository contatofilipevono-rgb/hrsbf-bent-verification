  (B : W₁ × W₂ →ₗ[ZMod 2] ι → ZMod 2) (g : V₁ → W₁) (h : V₂ → W₂) (L : Input ι →ₗ[ZMod 2] ι → ZMod 2) (k : ι → ZMod 2) :
