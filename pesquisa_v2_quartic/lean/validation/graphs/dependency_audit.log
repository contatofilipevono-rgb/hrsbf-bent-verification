VonoExactIndex.GraphFamily.graph_ANF_certified.{u_1, u_2} {ι : Type u_1} [Fintype ι] [DecidableEq ι] {κ : Type u_2}
  [Fintype κ] (adj : ι → ι → Bool) (hconn : CutConnected adj) (c : ι → ZMod 2) (L : Input ι →ₗ[ZMod 2] ι → ZMod 2)
  (l m : κ → Input ι →ₗ[ZMod 2] ZMod 2) (w : κ → ι → ZMod 2) :
  let Q := fun x i => c i + L x i + ∑ k, w k i * ((l k) x * (m k) x);
  HasVectorRelaxedIndex (addVector (graphMap adj) Q) (Fintype.card ι) ∧ ¬HasRelaxedSplit (addVector (graphMap adj) Q)
