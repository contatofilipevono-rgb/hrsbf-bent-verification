def filterCheck (k i : Nat) : Bool := normalizeFuel 20
  (compose 43 (H12Affine.rowU k) H12NumericFilters.explicitPolynomials[i]!) ==
    normalizeFuel 20 (targets[k]!)[i]!
theorem chart0_checked : (List.range 43).all (filterCheck 0) = true := by decide +kernel
#print axioms chart0_checked
theorem chart1_checked : (List.range 43).all (filterCheck 1) = true := by decide +kernel
#print axioms chart1_checked
theorem chart2_checked : (List.range 43).all (filterCheck 2) = true := by decide +kernel
#print axioms chart2_checked
theorem chart3_checked : (List.range 43).all (filterCheck 3) = true := by decide +kernel
#print axioms chart3_checked

theorem all_checked : (List.range 4).all (fun k => (List.range 43).all (filterCheck k)) = true := by
  change ((List.range 43).all (filterCheck 0) && ((List.range 43).all (filterCheck 1) &&
    ((List.range 43).all (filterCheck 2) && ((List.range 43).all (filterCheck 3) && true)))) = true
  simp only [chart0_checked,chart1_checked,chart2_checked,chart3_checked,Bool.true_and]

theorem exact_substitution (k : Fin 4) (i : Fin 43) : normalizeFuel 20
    (compose 43 (H12Affine.rowU k.val) H12NumericFilters.explicitPolynomials[i.val]!) =
      normalizeFuel 20 (targets[k.val]!)[i.val]! := by
  have hk := List.all_eq_true.mp all_checked k.val (List.mem_range.mpr k.isLt)
  exact beq_iff_eq.mp (List.all_eq_true.mp hk i.val (List.mem_range.mpr i.isLt))

theorem transformed_evaluation (k : Fin 4) (i : Fin 43) (u : BitVec 36) :
    evaluate 36 u.getLsbD (targets[k.val]!)[i.val]! =
      evaluate 43 (H12Affine.embed k.val u).getLsbD H12NumericFilters.explicitPolynomials[i.val]! := by
  have he := congrArg (evaluate 36 u.getLsbD) (exact_substitution k i)
  rw [evaluate_normalize, evaluate_normalize] at he
  exact he.symm.trans (affine_substitution k.val u _)

theorem target_lengths : ∀ k : Fin 4, (targets[k.val]!).length = 43 := by decide +kernel

theorem indexed_models (n : Nat) (f : Nat → Bool) (ps : List (List Nat))
    (len : ps.length = 43) (h : ∀ i : Fin 43, evaluate n f ps[i.val]! = false) : Models n f ps := by
  intro p hp
  obtain ⟨i,hi,he⟩ := List.getElem_of_mem hp
  have hib : i < 43 := by simpa [len] using hi
  have hv := h ⟨i,hib⟩
  rw [(getElem!_pos ps i hi).trans he] at hv
  exact hv

theorem bent_root (c : BitVec 43) (hb : H12Descent.BentAC (H12.quarticFunction c)) :
    ∃ k : Fin 3, ∃ u : BitVec 36,
      H12Affine.embed k.val u = c ∧ Models 36 u.getLsbD targets[k.val]! := by
  obtain ⟨k,hk⟩ := H12Affine.covers_bent c hb
  refine ⟨k,H12Affine.project c,hk,?_⟩
  let k4 : Fin 4 := ⟨k.val, by omega⟩
  apply indexed_models 36 _ _ (target_lengths k4)
  intro i
  have hp := H12FilterLink.bent_passes c hb i
  rw [H12FilterLink.values_as_map, H12FilterLink.map_lookup _ _ i.val
    (by simpa [H12NumericFilters.explicitPolynomials] using i.isLt)] at hp
  have he := transformed_evaluation k4 i (H12Affine.project c)
  change evaluate 36 (H12Affine.project c).getLsbD (targets[k.val]!)[i.val]! =
    evaluate 43 (H12Affine.embed k.val (H12Affine.project c)).getLsbD
      H12NumericFilters.explicitPolynomials[i.val]! at he
  rw [hk] at he
  exact he.trans hp

#print axioms bent_root
end H12ChartFilters
