import Std
namespace H12PlaneTables
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
def planes : List Nat := [,,,,,,,,,,,]
def planeCheck : Bool := (List.range 12).all (fun i => (List.range 4096).all
  (fun x => (planes[i]!).testBit x == x.testBit i))
theorem planeCheck_pass : planeCheck = true := by decide +kernel

theorem variable_semantics (i : Fin 12) (x : Fin 4096) :
    (planes[i.val]!).testBit x.val = x.val.testBit i.val := by
  have hi := List.all_eq_true.mp planeCheck_pass i.val (List.mem_range.mpr i.isLt)
  have hx := List.all_eq_true.mp hi x.val (List.mem_range.mpr x.isLt)
  exact beq_iff_eq.mp hx

#print axioms variable_semantics
end H12PlaneTables
