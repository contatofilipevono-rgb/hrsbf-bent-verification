import H12AffineState

namespace H12EmptyChart

open H12PackedPolynomial

set_option maxRecDepth 100000

set_option maxHeartbeats 1000000000

def rootPS : List Nat := [,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,1,,,,,,,,,,1,,0]

def rootObs : List Nat := [2,4,8,16,32,64,128,256,512,1024,2048,4096,8192,16384,32768,65536,131072,262144,524288,1048576,2097152,4194304,8388608,16777216,18415617,33554432,0,67108864,134217728,268435456,536870912,1073741824,2147483648,4294967296,8589934592,17179869184,10755310853,50405514,34359738368,68719476736,1,104152396504,1]

theorem rootObsBound : packedBounded rootObs := by
  intro p hp
  have h : rootObs.all (fun p => decide (p < 2^1333)) = true := by decide +kernel
  exact of_decide_eq_true (List.all_eq_true.mp h p hp)

def env0 : List Nat := [2,4,8,16,32,64,128,256,512,1024,2048,4096,8192,16384,32768,65536,131072,262144,524288,1048576,2097152,4194304,8388608,16777216,33554432,67108864,134217728,268435456,536870912,1073741824,2147483648,4294967296,8589934592,17179869184,34359738368,68719476736]

theorem envBound0 : H12AffineState.Bounded env0 := by
  intro p hp
  have h : env0.all (fun p => decide (p < 2^37)) = true := by decide +kernel
  exact of_decide_eq_true (List.all_eq_true.mp h p hp)

end H12EmptyChart