theorem all_filters_exact (j : Fin 43) :
    normalizeFuel 20 (fastPolynomial 12 (maskedRows j.val)) =
      normalizeFuel 20 explicitPolynomials[j.val]! := by
  exact beq_iff_eq.mp (List.all_eq_true.mp allChecks j.val (List.mem_range.mpr j.isLt))
