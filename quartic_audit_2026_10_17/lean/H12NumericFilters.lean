  change (filterCheck 0 && (filterCheck 1 && (filterCheck 2 && (filterCheck 3 && (filterCheck 4 && (filterCheck 5 && (filterCheck 6 && (filterCheck 7 && (filterCheck 8 && (filterCheck 9 && (filterCheck 10 && (filterCheck 11 && (filterCheck 12 && (filterCheck 13 && (filterCheck 14 && (filterCheck 15 && (filterCheck 16 && (filterCheck 17 && (filterCheck 18 && (filterCheck 19 && (filterCheck 20 && (filterCheck 21 && (filterCheck 22 && (filterCheck 23 && (filterCheck 24 && (filterCheck 25 && (filterCheck 26 && (filterCheck 27 && (filterCheck 28 && (filterCheck 29 && (filterCheck 30 && (filterCheck 31 && (filterCheck 32 && (filterCheck 33 && (filterCheck 34 && (filterCheck 35 && (filterCheck 36 && (filterCheck 37 && (filterCheck 38 && (filterCheck 39 && (filterCheck 40 && (filterCheck 41 && (filterCheck 42 && true))))))))))))))))))))))))))))))))))))))))))) = true
