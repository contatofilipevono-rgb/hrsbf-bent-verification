{
  "version": 1,
  "instructions": "Fila da branch integrada A100. Incremente revision para reexecutar.",
  "jobs": [
    {
      "id": "a100_smoke",
      "revision": 1,
      "enabled": true,
      "description": "Confirma CUDA/A100 e executa um teste curto em GPU.",
      "require_gpu": true,
      "timeout_seconds": 300,
      "script": "pesquisa_t32/gpu_probe.py",
      "args": []
    },
    {
      "id": "rs_bent_n12",
      "revision": 2,
      "enabled": true,
      "description": "Exhaustive RS degree<=3 bent search at n=12; tests antipodal rule and homogeneous cubic nonexistence.",
      "require_gpu": true,
      "timeout_seconds": 7200,
      "script": "rs_bent_exhaustive.py",
      "args": [
        "12",
        "12",
        "--backend",
        "cuda",
        "--resume",
        "--output-dir",
        "results/rs_bent_n12/rev_2"
      ],
      "artifacts": [
        "results/rs_bent_n12/rev_2/result_n12.json",
        "results/rs_bent_n12/rev_2/bent_ids_n12.npy",
        "results/rs_bent_n12/rev_2/checkpoint_n12.json"
      ]
    }
  ]
}
